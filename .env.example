DATABASE_URL=postgresql://licensing:localdev@localhost:5432/licensing
API_PORT=3001
ADMIN_URL=http://localhost:3000
NODE_ENV=development

APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_CALLBACK_URL=http://localhost:3001/v1/auth/callback
APS_SCOPES=openid email user-profile:read data:read

JWT_PORTAL_SECRET=change-me-generate-a-32-byte-hex
# Generate both with: pnpm keys:gen --write
JWT_SIGNING_KEY_PEM=
JWT_SIGNING_PUBLIC_PEM=
JWT_SIGNING_KID=k2026a
ENCRYPTION_KEY=

SMTP_HOST=localhost
SMTP_PORT=1025
# Slack or Microsoft Teams incoming webhook for the daily
# pending-access-request digest (job: pending-requests-digest). Leave blank to
# disable — the digest is then written to the API log instead. Treat the URL as
# a credential: anyone holding it can post to the channel, so it is never
# logged or written to audit_log.
NOTIFY_WEBHOOK_URL=
# Cloudflare Turnstile. Leave BOTH blank locally: the API skips
# verification without the secret, and the widget is skipped without the
# site key. Set both together, or logins fail in a confusing way.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

DEV_AUTH_HINT=true

# Autodesk endpoints. Leave these UNSET.
#
# They exist only so `pnpm test:e2e` can run the real sign-in code against the
# local OIDC issuer in tests/mock-aps/. The API refuses to boot with
# NODE_ENV=production if either points outside autodesk.com — see
# assertApsHostsAreAutodesk() in apps/api/src/env.ts.
# APS_AUTH_BASE=http://127.0.0.1:4599/authentication/v2
# APS_USERINFO_URL=http://127.0.0.1:4599/userinfo
